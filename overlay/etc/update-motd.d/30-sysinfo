# DO NOT EDIT THIS FILE but add config options to /etc/default/armbian-motd
# generate system information

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

THIS_SCRIPT="sysinfo"
MOTD_DISABLE=""
SHOW_IP_PATTERN="^[ewr].*|^br.*|^lt.*|^umts.*"

CPU_TEMP_LIMIT=70
GPU_TEMP_LIMIT=70

[[ -f /etc/default/armbian-motd ]] && . /etc/default/armbian-motd

for f in $MOTD_DISABLE; do
	[[ $f == $THIS_SCRIPT ]] && exit 0
done

# don't edit below here

disp_width() {
	local s="$1" LC_ALL=C
	local bytes=${#s}
	local LC_ALL=C.UTF-8
	local chars=${#s}
	DISP_W=$(( chars + (bytes - chars) / 2 ))
}

disp_pad() {
	local n
	disp_width "$1"
	printf '%s' "$1"
	n=$(( $2 - DISP_W ))
	[ "${n}" -gt 0 ] && printf '%*s' "${n}" ''
}

info_line() {
	# $1=name $2=value $3=color $4=cell width
	local label="$1" value="$2" color="${3:-92}" width="${4:-0}" n
	[ -n "${value}" ] || return 0
	disp_pad "${label}:" 14
	printf "\x1B[%sm %s\x1B[0m" "${color}" "${value}"
	if [ "${width}" -gt 0 ]; then
		disp_width "${value}"
		n=$(( width - 14 - 1 - DISP_W ))
		[ "${n}" -gt 0 ] && printf '%*s' "${n}" ''
	fi
}

# board model, device tree and SoC unique id
board_model=""
read -r -d '' board_model < /proc/device-tree/model 2>/dev/null

board_dtb=""
read -r -d '' board_dtb < /proc/device-tree/chosen/lubancat,dtb 2>/dev/null
if [ -z "${board_dtb}" ]; then
	read -r -d '' board_dtb < /proc/device-tree/compatible 2>/dev/null
	board_dtb="${board_dtb#*,}"
	[ -n "${board_dtb}" ] && board_dtb="${board_dtb}.dtb"
fi

cpuid=""
read -r -d '' cpuid < /proc/device-tree/serial-number 2>/dev/null
if [ -z "${cpuid}" ]; then
	while IFS= read -r line; do
		case "${line}" in
			Serial*) cpuid="${line#*: }"; break ;;
		esac
	done < /proc/cpuinfo
fi

# build information
sys_build="$(stat -c '%w' / 2>/dev/null)"
sys_build="${sys_build%%.*}"
case "${sys_build}" in -|"")
	sys_build="$(stat -c '%y' / 2>/dev/null)"
	sys_build="${sys_build%%.*}"
	;;
esac

kb="$(uname -v 2>/dev/null)"
kb="${kb#* }"
kb="${kb#SMP }"
kb="${kb#PREEMPT_RT }"
kb="${kb#PREEMPT_DYNAMIC }"
kb="${kb#PREEMPT }"
if [[ "${kb}" =~ ^([A-Za-z]{3}[[:space:]]+[A-Za-z]{3}[[:space:]]+[0-9]{1,2}[[:space:]]+[0-9]{2}:[0-9]{2}:[0-9]{2})[[:space:]]+[A-Z]{2,5}[[:space:]]+([0-9]{4})$ ]]; then
	kb="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
fi
kernel_build="$(date -d "${kb}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
[ -z "${kernel_build}" ] && kernel_build="${kb}"

gcc_ver=""
gcc_bin="$(readlink -f /usr/bin/gcc 2>/dev/null)"
gcc_pkg="$(dpkg-query -W -f='${Version}' "gcc-${gcc_bin##*-}" 2>/dev/null)"
if [ -n "${gcc_pkg}" ]; then
	gcc_pkg="${gcc_pkg#*:}"
	gcc_ver="gcc (Ubuntu ${gcc_pkg}) ${gcc_pkg%%-*}"
fi

# boot medium
root_src=""
while read -r dev mnt _; do
	if [ "${mnt}" = "/" ]; then
		root_src="${dev}"
		break
	fi
done < /proc/self/mounts

boot_medium=""
if [ -n "${root_src}" ]; then
	pk="${root_src#/dev/}"
	case "${pk}" in
		*p[0-9]*) pk="${pk%p[0-9]*}" ;;
		*[0-9]) pk="${pk%%[0-9]*}" ;;
	esac
	case "${pk}" in
		mmcblk*)
			read -r mmc_type < "/sys/block/${pk}/device/type" 2>/dev/null
			case "${mmc_type}" in
				SD) boot_medium="SD卡" ;;
				MMC) boot_medium="eMMC" ;;
				*) boot_medium="mmc" ;;
			esac
			;;
		nvme*) boot_medium="NVMe" ;;
		sd*|vd*)
			link="$(readlink -f "/sys/block/${pk}" 2>/dev/null)"
			case "${link}" in
				*usb*) boot_medium="USB" ;;
				*) boot_medium="SATA" ;;
			esac
			;;
		*) boot_medium="${pk}" ;;
	esac
	[ -n "${boot_medium}" ] && boot_medium="${boot_medium} (${pk})"
fi

# temperatures
board_cpu_temp=""
read -r temp_raw < /sys/class/thermal/thermal_zone0/temp 2>/dev/null && board_cpu_temp=$(( temp_raw / 1000 ))

board_gpu_temp=""
for zone in /sys/class/thermal/thermal_zone*; do
	[ -e "${zone}/temp" ] || continue
	read -r zone_type < "${zone}/type" 2>/dev/null || continue
	[ "${zone_type}" = "gpu-thermal" ] || continue
	read -r temp_raw < "${zone}/temp" 2>/dev/null && board_gpu_temp=$(( temp_raw / 1000 ))
	break
done

# load, uptime and logged in users
read -r load1 load5 load15 _ < /proc/loadavg
load="${load1} ${load5} ${load15}"

read -r up _ < /proc/uptime
up="${up%.*}"
if [ "${up}" -lt 3600 ]; then
	time="$(( up / 60 )) min"
elif [ "${up}" -lt 86400 ]; then
	time="$(( up / 3600 )):$(printf '%02d' $(( up % 3600 / 60 )))"
else
	time="$(( up / 86400 )) days"
fi

users=0
while IFS= read -r _; do
	users=$(( users + 1 ))
done < <(who 2>/dev/null)

# memory and swap
mem_total_kb=0; mem_free_kb=0; buffers_kb=0; cached_kb=0
swap_total_kb=0; swap_free_kb=0
while read -r key value _; do
	case "${key}" in
		MemTotal:) mem_total_kb=${value} ;;
		MemFree:) mem_free_kb=${value} ;;
		Buffers:) buffers_kb=${value} ;;
		Cached:) cached_kb=${value} ;;
		SwapTotal:) swap_total_kb=${value} ;;
		SwapFree:) swap_free_kb=${value} ;;
	esac
done < /proc/meminfo

if [ "${mem_total_kb}" -gt 0 ]; then
	memory_usage=$(( (mem_total_kb - mem_free_kb - buffers_kb - cached_kb) * 100 / mem_total_kb ))
	memory_total=$(( mem_total_kb / 1024 ))
else
	memory_usage=0
	memory_total=0
fi

if [ "${swap_total_kb}" -gt 0 ]; then
	swap_usage=$(( (swap_total_kb - swap_free_kb) * 100 / swap_total_kb ))
	swap_total=$(( swap_total_kb / 1024 ))
else
	swap_usage=0
	swap_total=0
fi

# ip address
ip_address=""
while read -r _ iface family addr _; do
	[ "${family}" = "inet" ] || continue
	iface="${iface%:}"
	[[ "${iface}" =~ ${SHOW_IP_PATTERN} ]] || continue
	ip_address="${ip_address:+${ip_address} }${addr%%/*}"
done < <(ip -4 -o addr show scope global 2>/dev/null)

# root filesystem
root_usage=""
root_total=""
while read -r _ size _ _ used_pct mnt; do
	[ "${mnt}" = "/" ] || continue
	root_usage="${used_pct%\%}"
	root_total="${size}"
	break
done < <(df -h / 2>/dev/null)

echo ""
# board model / device tree / build info
[ -n "${board_model}" ] && printf "%s\x1B[92m%s\x1B[0m\n" "板卡型号:     " "${board_model}"
[ -n "${board_dtb}" ] && printf "%s\x1B[92m%s\x1B[0m\n" "设备树:       " "${board_dtb}"
[ -n "${cpuid}" ] && printf "%s\x1B[92m%s\x1B[0m\n" "CPUID:        " "${cpuid}"
[ -n "${sys_build}" ] && printf "%s\x1B[92m%s\x1B[0m\n" "系统构建日期: " "${sys_build}"
[ -n "${kernel_build}" ] && printf "%s\x1B[92m%s\x1B[0m\n" "内核构建日期: " "${kernel_build}"
[ -n "${gcc_ver}" ] && printf "%s\x1B[92m%s\x1B[0m\n" "GCC环境:      " "${gcc_ver}"
[ -n "${boot_medium}" ] && printf "%s\x1B[92m%s\x1B[0m\n" "启动介质:     " "${boot_medium}"
echo ""

# display info
cpu_color=92
[ "${board_cpu_temp:-0}" -ge "${CPU_TEMP_LIMIT}" ] && cpu_color=91
gpu_color=92
[ "${board_gpu_temp:-0}" -ge "${GPU_TEMP_LIMIT}" ] && gpu_color=91
root_color=92
[ "${root_usage:-0}" -ge "90" ] && root_color=91

cpu_val=""
[ -n "${board_cpu_temp}" ] && cpu_val="${board_cpu_temp}°C"
gpu_val=""
[ -n "${board_gpu_temp}" ] && gpu_val="${board_gpu_temp}°C"
root_val=""
[ -n "${root_usage}" ] && root_val="${root_usage}% 共 ${root_total}"

info_line "系统负载" "${load}" 92 32
info_line "运行时长" "${time}" 92
echo ""
info_line "在线用户" "${users}" 92 32
info_line "IP地址" "${ip_address}" 92
echo ""
info_line "内存占用" "${memory_usage} % 共 ${memory_total}MB" 92 32
info_line "Zram占用" "${swap_usage} % 共 ${swap_total}Mb" 92
echo ""
info_line "CPU温度" "${cpu_val}" "${cpu_color}" 32
info_line "GPU温度" "${gpu_val}" "${gpu_color}"
echo ""
info_line "根分区" "${root_val}" "${root_color}"
echo ""
echo ""
