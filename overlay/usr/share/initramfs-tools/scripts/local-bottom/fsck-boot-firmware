#!/bin/sh

PREREQ=""

prereqs()
{
	echo "$PREREQ"
}

case "$1" in
prereqs)
	prereqs
	exit 0
	;;
esac

. /scripts/functions

BOOTDEV=""
for arg in $(cat /proc/cmdline); do
	case "$arg" in
	lubancat.bootdev=*) BOOTDEV="${arg#lubancat.bootdev=}" ;;
	esac
done

if [ -n "$BOOTDEV" ] && [ -b "$BOOTDEV" ]; then
	checkfs "$BOOTDEV" /boot/firmware ext4
else
	log_warning_msg "No boot device from kernel command line; skipping boot filesystem check."
fi
