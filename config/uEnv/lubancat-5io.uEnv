overlays=rk3588-lubancat-5io-hdmi0-vp0-overlay rk3588-lubancat-5io-hdmi1-vp1-overlay

# 正确的方法是将所有需要的设备树覆盖文件名列在一个overlays=后面，用空格分隔。例如：
# 下面是为鲁班猫5io使用两个覆盖层的示例:      
# overlays=rk3588-lubancat-5io-hdmi0-vp0-overlay rk3588-lubancat-5io-hdmi1-vp1-overlay

# rk3588-lubancat-uart4-m2-overlay
# rk3588-lubancat-uart7-m2-overlay
# rk3588-lubancat-5io-rs485-1-overlay
# rk3588-lubancat-5io-rs485-2-overlay

# Display 显示输出配置
# 8k插件，开启之后vp0的hdmi0或者hdmi1能输出8k
# rk3588-lubancat-hdmi-8k-overlay

# vp0 (插件只能同时开一个)
# rk3588-lubancat-5io-hdmi0-vp0-overlay
# rk3588-lubancat-5io-hdmi1-vp0-overlay

# vp1 (默认配置为dp0开启，打开设备树则关闭dp显示)
# rk3588-lubancat-dp0-disabled-overlay

# vp2 (插件只能同时开一个)
# rk3588-lubancat-5io-hdmi1-vp2-overlay
# rk3588-lubancat-5io-dsi0-vp2-1080p-overlay
# rk3588-lubancat-5io-dsi0-vp2-800x1280-overlay
# rk3588-lubancat-5io-dsi0-vp2-800x1280-10.1inch-s8001280b1060b-overlay
# rk3588-lubancat-5io-dsi0-vp2-1024x600-overlay
# rk3588-lubancat-5io-dsi0-vp2-generic-overlay

# vp3 (插件只能同时开一个)
# rk3588-lubancat-5io-dsi1-vp3-1080p-overlay
